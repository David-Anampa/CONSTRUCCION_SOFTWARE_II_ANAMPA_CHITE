rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    // ✅ Verifica si el usuario autenticado tiene rol 'admin' en Firestore
    function esAdmin() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{userId} {
      allow read: if estaAutenticado();
      allow create: if esDueno(userId);
      // ✅ Admin puede actualizar cualquier usuario (activar/desactivar)
      allow update: if esDueno(userId) || esAdmin();
      allow delete: if esDueno(userId) || esAdmin();
    }

    match /reportes_mascotas/{reporteId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update: if estaAutenticado()
                    && (resource.data.usuarioId == request.auth.uid
                        || request.resource.data.keys().hasOnly(['estado'])
                        || esAdmin());
      // ✅ Admin puede eliminar reportes de cualquier usuario
      allow delete: if (estaAutenticado()
                    && resource.data.usuarioId == request.auth.uid)
                    || esAdmin();

      match /comentarios/{comentarioId} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado()
                      && request.resource.data.uid == request.auth.uid;
        allow update: if estaAutenticado()
                      && (resource.data.uid == request.auth.uid
                          || request.resource.data.keys().hasOnly(['likes']));
        allow delete: if (estaAutenticado()
                      && resource.data.uid == request.auth.uid)
                      || esAdmin();
      }
    }

    match /avistamientos/{avistamientoId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update: if estaAutenticado()
                    && (resource.data.usuarioId == request.auth.uid
                        || request.resource.data.keys().hasOnly(['reporteId', 'estado'])
                        || esAdmin());
      // ✅ Admin puede eliminar avistamientos de cualquier usuario
      allow delete: if (estaAutenticado()
                    && resource.data.usuarioId == request.auth.uid)
                    || esAdmin();

      match /comentarios/{comentarioId} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado()
                      && request.resource.data.uid == request.auth.uid;
        allow update: if estaAutenticado()
                      && (resource.data.uid == request.auth.uid
                          || request.resource.data.keys().hasOnly(['likes']));
        allow delete: if (estaAutenticado()
                      && resource.data.uid == request.auth.uid)
                      || esAdmin();
      }
    }

    match /comentarios/{comentarioId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if estaAutenticado()
                    && (resource.data.uid == request.auth.uid
                        || request.resource.data.keys().hasOnly(['likes', 'dislikes', 'shares']));
      allow delete: if (estaAutenticado()
                    && resource.data.uid == request.auth.uid)
                    || esAdmin();

      match /respuestas/{respuestaId} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado()
                      && request.resource.data.uid == request.auth.uid;
        allow update: if estaAutenticado()
                      && (resource.data.uid == request.auth.uid
                          || request.resource.data.keys().hasOnly(['likes']));
        allow delete: if (estaAutenticado()
                      && resource.data.uid == request.auth.uid)
                      || esAdmin();
      }
    }

    match /chats/{chatId} {
      allow read: if estaAutenticado()
                  && request.auth.uid in resource.data.usuarios;
      allow create: if estaAutenticado()
                    && request.auth.uid in request.resource.data.usuarios;
      allow update: if estaAutenticado()
                    && request.auth.uid in resource.data.usuarios;
      allow delete: if false;

      match /mensajes/{mensajeId} {
        allow read: if estaAutenticado()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.usuarios;
        allow create: if estaAutenticado()
                      && request.resource.data.emisorId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.usuarios;
        allow update: if estaAutenticado()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.usuarios;
        allow delete: if false;
      }
    }

    match /notificaciones/{notifId} {
      // ✅ Admin puede leer todas las notificaciones
      allow read: if estaAutenticado()
                  && (resource.data.usuarioId == request.auth.uid || esAdmin());
      allow create: if estaAutenticado();
      allow update: if estaAutenticado()
                    && resource.data.usuarioId == request.auth.uid;
      allow delete: if (estaAutenticado()
                    && resource.data.usuarioId == request.auth.uid)
                    || esAdmin();
    }

    // ✅ Colecciones de eliminados - solo admin
    match /reportes_eliminados/{docId} {
      allow read: if esAdmin();
      allow write: if esAdmin();
    }

    match /avistamientos_eliminados/{docId} {
      allow read: if esAdmin();
      allow write: if esAdmin();
    }

    match /tokens/{tokenId} {
      allow read, write: if estaAutenticado();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
